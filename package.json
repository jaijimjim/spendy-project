{
  "name": "spendy-money",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spendy Money — record income & expenses automatically from slip images (in-browser OCR, TH/EN).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "assets:tesseract": "node scripts/copy-tesseract-assets.mjs",
    "predev": "npm run assets:tesseract",
    "dev": "vite",
    "prebuild": "npm run assets:tesseract",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ocr": "playwright test --project=real-ocr",
    "size:check": "node scripts/check-bundle-size.mjs",
    "ci": "npm run typecheck && npm run lint && npm run i18n:check && npm run test:coverage && npm run build && npm run size:check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "i18next": "27.1.1",
    "lucide-react": "1.72.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.65.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/tha": "1.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "tesseract.js-core": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "4.0.18"
  }
}
